[gd_resource type="Resource" script_class="BgmTrackDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://addons/stella/core/data/bgm_track_definition.gd" id="1_track"]
[ext_resource type="Script" path="res://addons/stella/core/data/bgm_stem_definition.gd" id="2_stem"]
[ext_resource type="Script" path="res://addons/stella/core/data/bgm_cue_definition.gd" id="3_cue"]
[ext_resource type="AudioStreamWAV" path="res://examples/demo/audio/bgm/synthetic_stem_tone.tres" id="4_tone"]

[sub_resource type="Resource" id="Resource_rhythm"]
script = ExtResource("2_stem")
stem_name = "rhythm"
stream = ExtResource("4_tone")
default_gain = 1.0

[sub_resource type="Resource" id="Resource_harmony"]
script = ExtResource("2_stem")
stem_name = "harmony"
stream = ExtResource("4_tone")
default_gain = 0.0

[sub_resource type="Resource" id="Resource_opening"]
script = ExtResource("3_cue")
cue_name = "opening"
loop = true
start_position = 0.01
loop_position = 0.05

[resource]
script = ExtResource("1_track")
stems = Array[ExtResource("2_stem")]([SubResource("Resource_rhythm"), SubResource("Resource_harmony")])
loop = true
start_position = 0.0
loop_position = 0.05
cues = Array[ExtResource("3_cue")]([SubResource("Resource_opening")])
