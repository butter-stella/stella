[gd_resource type="Resource" script_class="BgmTrackDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://addons/stella/core/data/bgm_track_definition.gd" id="1_track"]
[ext_resource type="Script" path="res://addons/stella/core/data/bgm_stem_definition.gd" id="2_stem"]
[ext_resource type="Script" path="res://addons/stella/core/data/bgm_marker_definition.gd" id="3_marker"]
[ext_resource type="AudioStreamOggVorbis" path="res://tests/fixtures/audio/bgm/synthetic_loop_region.ogg" id="4_stream"]

[sub_resource type="Resource" id="Resource_rhythm"]
script = ExtResource("2_stem")
