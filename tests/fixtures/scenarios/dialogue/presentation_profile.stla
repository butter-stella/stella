// E2E fixture: declarative NVL presentation followed by an ADV restoration.
@dialogue_profile novel panel_anchors=0,0,1,1 panel_offsets=0,0,0,0 panel_modulate=#ffffffff
@dialogue_profile novel text_anchors=0.18,0.12,0.82,0.62 text_offsets=8,12,-16,-24 text_margins=10,12,14,18
@dialogue_profile novel horizontal_alignment=center vertical_alignment=center line_spacing=9
@dialogue_profile novel fit_content=false scroll_active=true scroll_following=true autowrap_mode=word_smart clip_contents=true
@dialogue_profile novel background_visible=true background_modulate=#ffffff00
@dialogue_profile novel show=quick_menu hide=adv_chrome
@dialogue_profile novel entry_prefix="・" entry_separator=""
@dialogue_profile restore_first entry_prefix="A" entry_separator="|"
@dialogue_profile restore_second entry_prefix="B" entry_separator="~"

@chapter dialogue_presentation "Dialogue Presentation Profile"
@scene start
@nvl profile=novel
「First」
「Second」
「Third」
@nvl off
「Back in ADV」
@jump runtime_fixture_done

// Runtime page-boundary fixtures. Each entry scene jumps to a shared terminal
// scene so tests can start it directly without falling through into the next
// independent case.
@scene jump_loop_entry
@set jump_count = 0
@jump jump_loop_page

@scene jump_loop_page
@nvl profile=novel
「Jump page」
@nvl off
@set jump_count += 1
@if jump_count < 2
@jump jump_loop_page
@end
@jump runtime_fixture_done

@scene repeated_call_entry
@call called_nvl_page
@call called_nvl_page
@jump runtime_fixture_done

@scene called_nvl_page
@nvl profile=novel
「Called page」
@nvl off

@scene branch_true_entry
@set branch_flag = true
@jump conditional_nvl_page

@scene branch_false_entry
@set branch_flag = false
@jump conditional_nvl_page

@scene conditional_nvl_page
@if branch_flag
@nvl off
@nvl profile=novel
「True branch」
@else
@nvl off
@nvl profile=novel
「False branch」
@end
「After branch」
@nvl off
@jump runtime_fixture_done

@scene repeated_nvl_entry
@nvl profile=novel
「Repeated one」
@nvl profile=novel
「Repeated two」
@nvl off
@jump runtime_fixture_done

@scene cross_profile_restore
@nvl profile=restore_first
「One」
@nvl profile=restore_second
「Two」
@nvl off
@jump runtime_fixture_done

@scene nested_true_true_entry
@set outer_flag = true
@set inner_flag = true
@jump nested_conditional_page

@scene nested_true_false_entry
@set outer_flag = true
@set inner_flag = false
@jump nested_conditional_page

@scene nested_false_true_entry
@set outer_flag = false
@set inner_flag = true
@jump nested_conditional_page

@scene nested_false_false_entry
@set outer_flag = false
@set inner_flag = false
@jump nested_conditional_page

@scene nested_conditional_page
@nvl profile=novel
「Nested seed」
@if outer_flag
@if inner_flag
@nvl off
@nvl profile=novel
「TT branch」
@else
「TF branch」
@end
@else
@if inner_flag
@nvl off
@nvl profile=novel
「FT branch」
@else
「FF branch」
@end
@end
「Nested continuation」
@nvl off
@jump runtime_fixture_done

@scene runtime_fixture_done
