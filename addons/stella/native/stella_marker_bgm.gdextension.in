[configuration]

entry_symbol = "stella_marker_bgm_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]

macos.debug = "res://addons/stella/native/bin/libstella_marker_bgm.macos.template_debug.universal.dylib"
macos.release = "res://addons/stella/native/bin/libstella_marker_bgm.macos.template_release.universal.dylib"
linux.debug.x86_64 = "res://addons/stella/native/bin/libstella_marker_bgm.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/stella/native/bin/libstella_marker_bgm.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/stella/native/bin/stella_marker_bgm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/stella/native/bin/stella_marker_bgm.windows.template_release.x86_64.dll"
