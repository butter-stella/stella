# Godot — local editor cache + imported binary blobs (auto-regenerated).
# Note: do NOT ignore *.import sidecar files — they hold the resource UID and
# import settings that all collaborators must share, otherwise UID-referencing
# scenes break when re-imported on a fresh clone.
.godot/

# IDE
.idea/
.vs/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Export
export/
*.pck
*.zip

# Demo BGM (copyrighted, local use only)
examples/demo/audio/bgm/*.mp3
examples/demo/audio/bgm/*.ogg

# Test results
.gut_editor_config.json
